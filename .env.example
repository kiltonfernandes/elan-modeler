# Server only. Add these in Vercel > Settings > Environment Variables.
# New Turso engine: turso://database-organization.turso.io
# libSQL engine: libsql://database-organization.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: auto-detected from turso:// or libsql://. For HTTPS, set explicitly.
# TURSO_DATABASE_DRIVER=turso

# Local-only development can use file:./elan-dev.db (driver libsql).
# No VITE_ prefix: database credentials must never enter the browser bundle.

# Optional, only for Notion clients requiring header authentication.
# /mcp stays public, without a key. /mcp/notion verifies this separate token.
# ELAN_MCP_NOTION_TOKEN=
# Optional canonical URL for self-hosting; Vercel detects its host automatically.
# ELAN_PUBLIC_URL=https://your-elan.example
# Optional additional exact browser origins (comma-separated, no wildcard).
# ELAN_MCP_ALLOWED_ORIGINS=
